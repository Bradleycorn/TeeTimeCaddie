    <!-- ==== Error taxonomy (TTC-77) ==== -->

    <!-- Generic title for auth failures that have no more specific one. -->
    <string name="auth_error_title">Something went wrong</string>

    <!--
      Sign-in failure. Deliberately says nothing about WHICH half was wrong: with Firebase email
      enumeration protection enabled, "no such account" and "wrong password" are indistinguishable,
      and disclosing either would be the leak the protection exists to prevent.
    -->
    <string name="login_error_invalid_credentials_title">That email and password don\'t match</string>
    <string name="login_error_invalid_credentials_message">Check them and try again, or create a new account.</string>

    <!-- Sign-up rejected because the address already has an account. %s is the email address. -->
    <string name="reg_error_email_in_use_title">That email is already in use</string>
    <string name="reg_error_email_in_use_message">An account with %s already exists. Sign in instead?</string>
    <string name="reg_error_email_in_use_recovery">Sign in instead</string>

