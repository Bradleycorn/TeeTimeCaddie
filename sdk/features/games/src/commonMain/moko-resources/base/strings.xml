<?xml version="1.0" encoding="UTF-8" ?>
<resources>
    <!-- Tab label. The list screen shows the brand name as its title; this names the tab. -->
    <string name="games_title">Games</string>

    <!-- ==== Games tab (TTC-68) ==== -->
    <string name="games_upcoming_header">Upcoming games</string>
    <string name="games_empty_title">No games yet</string>
    <string name="games_empty_message">Booked a tee time? Turn it into a game so your foursome lives somewhere other than a text thread.</string>
    <string name="games_create_button">Create a game</string>
    <!-- Spoken label for the + control that opens New game. -->
    <string name="games_new_game_action">New game</string>
    <!-- A row's second line: the formatted date, then the tee time. "Sat, Jun 13 · 9:00 AM" -->
    <string name="games_row_date_time">%1$s · %2$s</string>
    <!-- A row's player count: the organizer and everyone who said yes. -->
    <string name="games_row_player_count_one">1 player</string>
    <string name="games_row_player_count_many">%s players</string>
    <!-- A row's status chip. -->
    <string name="games_status_open">Open</string>
    <string name="games_status_pending">Pending</string>
    <string name="games_status_full">Full</string>

    <!-- ==== Invitations (TTC-70) ==== -->
    <!-- The invite card's header, for one pending invitation and for more. -->
    <string name="games_invites_header_one">New invite</string>
    <string name="games_invites_header_many">%s new invites</string>
    <!-- Chip beside the course on an invite whose tee time is already full. -->
    <string name="games_invite_full_chip">Full</string>
    <!-- Confirmations after answering, from the list or from Game details. "Pebble Beach confirmed" -->
    <string name="game_invite_accepted_message">%s confirmed</string>
    <string name="game_invite_declined_message">Invite declined</string>

    <!-- ==== New game (TTC-68) ==== -->
    <string name="new_game_title">New game</string>
    <string name="new_game_section_where_when">Where &amp; when</string>
    <string name="new_game_field_course">Course</string>
    <string name="new_game_field_course_placeholder">e.g. Pebble Beach</string>
    <string name="new_game_field_date">Date</string>
    <string name="new_game_field_date_placeholder">Pick a date</string>
    <string name="new_game_field_tee_time">Tee time</string>
    <string name="new_game_field_tee_time_placeholder">Set tee time</string>
    <string name="new_game_section_players">How many players</string>
    <string name="new_game_player_slots_label">Player slots</string>
    <string name="new_game_section_invitees">Invitees</string>
    <string name="new_game_add_from_contacts">Add from contacts</string>
    <string name="new_game_add_more_from_contacts">Add more from contacts</string>
    <!-- Content description for an invitee row's remove button. "Remove Matt Chen" -->
    <string name="new_game_remove_invitee">Remove %1$s</string>
    <string name="new_game_publish_button">Publish game</string>
    <!-- Spoken label for the Android ✕ that leaves New game. -->
    <string name="new_game_close">Close</string>

    <!--
      Asked before publishing a game with nobody invited. The copy is proposed in the story, not
      drawn in the design.
    -->
    <string name="new_game_no_invitees_title">Publish with no invitees?</string>
    <string name="new_game_no_invitees_message">You haven\'t invited anyone to this game yet.</string>
    <string name="new_game_no_invitees_keep_editing">Keep editing</string>
    <string name="new_game_no_invitees_publish_anyway">Publish anyway</string>

    <!-- The confirmation after publishing. The course name is the stored spelling. -->
    <string name="new_game_published_message">%s game published</string>

    <!-- ==== Game details (TTC-68) ==== -->
    <string name="game_details_title">Game details</string>
    <string name="game_details_organizer_chip">You are the organizer</string>
    <string name="game_details_organizer_label">Organizer</string>
    <string name="game_details_invited_label">Invited</string>
    <string name="game_details_empty_slot">Empty slot</string>
    <!-- A tee time's fill count: players, then slots. "1/4 filled" -->
    <string name="game_details_filled_count">%1$s/%2$s filled</string>
    <!-- Label on a row for someone holding a slot, other than the organizer. -->
    <string name="game_details_confirmed_label">Confirmed</string>
    <!-- The organizer's Declined section heading, with how many declined. "Declined · 2" -->
    <string name="game_details_declined_heading">Declined · %s</string>
    <!-- The signed-in player's own row: their first name. "Dana (you)" -->
    <string name="game_details_viewer_name">%s (you)</string>
    <!-- Under the course in the invitee view: the date, then the organizer's first name. "Sat, Jun 13 · Organized by Brad" -->
    <string name="game_details_organized_by">%1$s · Organized by %2$s</string>
    <!-- The RSVP card's title, with the organizer's first name. "Brad invited you to play" -->
    <string name="game_details_rsvp_title">%s invited you to play</string>
    <!-- The RSVP card, while the viewer hasn't answered. -->
    <string name="game_details_rsvp_prompt">Can you make it?</string>
    <!-- Replaces the prompt when confirmed players fill every slot. "All 4 spots are taken." -->
    <string name="game_details_rsvp_full">All %s spots are taken.</string>
    <!-- The RSVP card once answered. -->
    <string name="game_details_rsvp_accepted">You\'re in</string>
    <string name="game_details_rsvp_declined">You declined</string>

    <!-- ==== Recording a response for an invitee (TTC-72) ==== -->
    <!-- The ⋮ on an invitee's row in the organizer's view, for screen readers. "Record Dana's response" -->
    <string name="game_details_response_more">Record %s\'s response</string>
    <!-- The organizer's response sheet, with the name the person was invited by. "Dana's response" -->
    <string name="game_details_response_title">%s\'s response</string>
    <!-- Under the sheet's title: the invitee's name, then the tee time. "Record a reply on Dana's behalf for the 9:00 AM tee time." -->
    <string name="game_details_response_prompt">Record a reply on %1$s\'s behalf for the %2$s tee time.</string>
    <!-- Under Yes in the sheet, with the tee time. "Playing at 9:00 AM" -->
    <string name="game_details_response_yes_detail">Playing at %s</string>
    <!-- Replaces the line under Yes once Yes answers fill every slot. "9:00 AM is full" -->
    <string name="game_details_response_yes_full">%s is full</string>
    <!-- Under No in the sheet. -->
    <string name="game_details_response_no_detail">Can\'t make it</string>
    <!-- The confirmation once the organizer's answer is saved, with the invitee's name. "Dana marked as Yes" -->
    <string name="game_details_response_recorded_yes">%s marked as Yes</string>
    <string name="game_details_response_recorded_no">%s marked as No</string>

    <!-- ==== Errors ==== -->
    <string name="game_error_title">We couldn\'t publish your game</string>
    <string name="game_error_no_course_message">Enter the course you\'re playing.</string>
    <string name="game_error_invalid_slots_message">A tee time holds between 1 and 4 players.</string>
    <string name="game_error_invalid_invitee_message">One of your invitees is missing a name or a valid phone number.</string>
    <string name="game_error_publish_failed_message">Your game didn\'t make it to the clubhouse.</string>
    <string name="game_error_publish_failed_recovery">Try again.</string>
    <string name="game_error_not_found_title">That game is gone</string>
    <string name="game_error_not_found_message">We couldn\'t find that game.</string>
    <string name="game_error_load_failed_title">We couldn\'t load that game</string>
    <string name="game_error_load_failed_message">Something went wrong reading it.</string>
    <string name="game_error_load_failed_recovery">Try again.</string>
    <string name="game_error_game_full_title">This game just filled up</string>
    <string name="game_error_game_full_message">Every spot was taken before your answer arrived.</string>
    <string name="game_error_respond_failed_title">We couldn\'t send your answer</string>
    <string name="game_error_respond_failed_message">Something went wrong saving it.</string>
    <string name="game_error_respond_failed_recovery">Try again.</string>
</resources>
