rules_version = '2';

// ===============================================================
// Assumed Data Model
// ===============================================================
//
// Collection: players
// Document ID: the player's Firebase Auth uid
// Fields:
//   - name: string (required, non-empty) - display name
//   - email: string (required, equals the auth token's email, immutable)
//   - phone: string (required, digits only, 10-15) - matched against invitations
//   - photoUrl: string (optional) - avatar download URL
//
// Collection: courses
// Document ID: nameKey — the course name normalised for matching (lowercase, single spaces)
// Fields:
//   - name: string (required, 1-100) - the spelling the first organizer typed
//   - nameKey: string (required, 1-100, equals the document id)
// Shared by every organizer and owned by nobody, so never updated or deleted. Only ever created
// inside the transaction that publishes a game.
//
// Collection: games
// Document ID: auto
// Fields:
//   - organizerId: string (required, creator's uid, immutable)
//   - courseId: string (required, 1-100) - id of an existing courses document
//   - courseName: string (required, 1-100) - copy of that course's name
//   - date: string (required, ISO "YYYY-MM-DD") - a calendar day, not an instant
//   - teeTimes: list (required, exactly 1 for now) of maps:
//       - time: string (required, ISO "HH:MM" with optional seconds)
//       - slots: int (required, 1-4)
//       - players: list (required, size <= slots) of maps, one per seat:
//           - playerId: string or null (required) - the seat holder's uid; null for an invitee
//               with no account whose Yes the organizer recorded
//           - name: string (required, 1-100) - the player's profile name, or the name the
//               organizer invited them by when the organizer recorded their Yes
//           - phone: string (required, digits only) - the seat holder's number: their profile's,
//               or the one they were invited by. Identifies a seat that has no playerId.
//   - playerIds: list of strings (required) - everyone holding a slot; drives reads
//   - invitedPhones: list of strings (required, may be empty, <= 50, no repeats) - the phone
//       number each invitee was invited by (digits only, 10-15), for the array-contains query that
//       finds a number's invitations. Written once, at publish.
//   - createdAt: timestamp (required, the server's time at creation)
//
// Subcollection: games/{gameId}/invitees
// Document ID: the phone number the person was invited by — one of the game's invitedPhones
// One document per invitee, so every answer is a write to exactly one person's document and the
// rules can tie it to that person through the path.
// Fields:
//   - name: string (required, 1-100) - the name the organizer invited them by
//   - playerId: string or null (required) - the player who owned that number at publish, if any;
//       the answering player's uid once they answer
//   - status: string (required) - "PENDING", then "ACCEPTED" or "DECLINED" once they answer
//   - order: int (required) - the position the organizer added them in
// Created only in the write that publishes the game. A Yes changes this document and takes a
// seat in the game in the same atomic write; a No changes only this document. The answer is the
// invitee's own, or one the game's organizer recorded for them.
//
// ===============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Helper Functions
    // ===============================================================

    function isSignedIn() {
      return request.auth != null;
    }

    function isSelf(playerId) {
      return isSignedIn() && request.auth.uid == playerId;
    }

    function isStringOfLength(value, minLen, maxLen) {
      return value is string && value.size() >= minLen && value.size() <= maxLen;
    }

    function coursePath(courseId) {
      return /databases/$(database)/documents/courses/$(courseId);
    }

    function playerPath(playerId) {
      return /databases/$(database)/documents/players/$(playerId);
    }

    function gamePath(gameId) {
      return /databases/$(database)/documents/games/$(gameId);
    }

    function inviteePath(gameId, phone) {
      return /databases/$(database)/documents/games/$(gameId)/invitees/$(phone);
    }

    // ===============================================================
    // Domain Validators
    // ===============================================================

    function isValidCourse(data, courseKey) {
      return data.keys().hasOnly(['name', 'nameKey'])
        && data.keys().hasAll(['name', 'nameKey'])
        && isStringOfLength(data.name, 1, 100)
        && isStringOfLength(data.nameKey, 1, 100)
        && data.nameKey == courseKey
        // The key is derived from the name, so nobody can claim a course's key under a
        // different name. Mirrors courseKey() in the games SDK module.
        && data.name.lower().replace('/', '-') == data.nameKey;
    }

    // The organizer, and only the organizer, in a new tee time's first slot. The name and phone
    // must match their profile, so a game cannot show anyone under a name they did not choose.
    function isOrganizerSlot(player) {
      return player == mySeat();
    }

    function isValidNewTeeTime(teeTime) {
      return teeTime is map
        && teeTime.keys().hasOnly(['time', 'slots', 'players'])
        && teeTime.keys().hasAll(['time', 'slots', 'players'])
        && teeTime.time is string
        && teeTime.time.matches('^[0-9]{2}:[0-9]{2}(:[0-9]{2}([.][0-9]+)?)?$')
        && teeTime.slots is int
        && teeTime.slots >= 1
        && teeTime.slots <= 4
        && teeTime.players is list
        && teeTime.players.size() == 1
        && teeTime.players.size() <= teeTime.slots
        && isOrganizerSlot(teeTime.players[0]);
    }

    // The numbers a new game invites: digits only (checked at once by joining them), no repeats.
    // Each number's invitee document is checked by its own rule; this proves the first one is
    // written alongside the game, so publishing can't leave a game with invitations nobody can
    // answer.
    function isValidNewInvitedPhones(gameId, phones) {
      return phones is list
        && phones.size() <= 50
        && phones.toSet().size() == phones.size()
        && (phones.size() == 0 || (
          phones.join(',').matches('^[0-9]{10,15}(,[0-9]{10,15})*$')
          && existsAfter(inviteePath(gameId, phones[0]))
        ));
    }

    // A game as it is first published: one tee time, holding only the organizer, at a course that
    // exists once this write lands (it may be created in the same transaction, hence getAfter).
    // Invitees don't hold slots until they say yes, so they aren't in playerIds.
    function isValidNewGame(gameId, data) {
      return data.keys().hasOnly([
          'organizerId', 'courseId', 'courseName', 'date', 'teeTimes', 'playerIds',
          'invitedPhones', 'createdAt'
        ])
        && data.keys().hasAll([
          'organizerId', 'courseId', 'courseName', 'date', 'teeTimes', 'playerIds',
          'invitedPhones', 'createdAt'
        ])
        && data.organizerId == request.auth.uid
        && isStringOfLength(data.courseId, 1, 100)
        && isStringOfLength(data.courseName, 1, 100)
        && existsAfter(coursePath(data.courseId))
        && getAfter(coursePath(data.courseId)).data.nameKey == data.courseId
        && getAfter(coursePath(data.courseId)).data.name == data.courseName
        && data.date is string
        && data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && data.teeTimes is list
        && data.teeTimes.size() == 1
        && isValidNewTeeTime(data.teeTimes[0])
        && data.playerIds == [request.auth.uid]
        && isValidNewInvitedPhones(gameId, data.invitedPhones)
        && data.createdAt == request.time;
    }

    // The signed-in player's profile. Invitations are matched against its phone number.
    function myProfile() {
      return get(playerPath(request.auth.uid)).data;
    }

    // Whether the signed-in player was invited to this game, by their profile's number.
    function isInvited(data) {
      return myProfile().phone in data.invitedPhones;
    }

    // The seat the signed-in player holds: their uid, profile name and profile number.
    function mySeat() {
      return {
        'playerId': request.auth.uid,
        'name': myProfile().name,
        'phone': myProfile().phone
      };
    }

    // Whether the account [playerId] currently has [phone] on its profile. The playerId an
    // organizer wrote on an invitation at publish is only a claim; this is what proves it.
    function ownsNumber(playerId, phone) {
      return playerId != null
        && exists(playerPath(playerId))
        && get(playerPath(playerId)).data.phone == phone;
    }

    // An invitee document as the organizer writes it when publishing: a pending invitation for
    // one of the game's numbers. The playerId is the organizer's claim and grants nothing:
    // invitations are found and answered by phone number.
    function isValidNewInvitee(invitee) {
      return invitee.keys().hasOnly(['name', 'playerId', 'status', 'order'])
        && invitee.keys().hasAll(['name', 'playerId', 'status', 'order'])
        && isStringOfLength(invitee.name, 1, 100)
        && (invitee.playerId == null || isStringOfLength(invitee.playerId, 1, 128))
        && invitee.status == 'PENDING'
        && invitee.order is int;
    }

    // Only in the write that publishes the game, by its organizer, for one of its numbers. The
    // game must not exist before this write, so nobody can add an invitation to a published game.
    function isPublishingInvitee(gameId, phone) {
      let game = getAfter(gamePath(gameId)).data;
      return !exists(gamePath(gameId))
        && game.organizerId == request.auth.uid
        && phone in game.invitedPhones
        && isValidNewInvitee(request.resource.data);
    }

    // An invitee's first answer, to their own invitation: the document under their profile's
    // number. Only the status (PENDING to ACCEPTED or DECLINED) and the playerId, which becomes
    // their own uid, change. A Yes takes a seat in the game in the same write (the game's own
    // rule checks the seat); a No leaves the game alone. Changing an answer, or answering for
    // someone else, is not allowed.
    function isValidAnswer(gameId, phone, before, after) {
      let game = get(gamePath(gameId)).data;
      return phone == myProfile().phone
        && phone in game.invitedPhones
        && before.status == 'PENDING'
        && after.diff(before).affectedKeys().hasOnly(['status', 'playerId'])
        && after.playerId == request.auth.uid
        && (
          (after.status == 'DECLINED'
            && !(request.auth.uid in getAfter(gamePath(gameId)).data.playerIds))
          || (after.status == 'ACCEPTED'
            && !(request.auth.uid in game.playerIds)
            && request.auth.uid in getAfter(gamePath(gameId)).data.playerIds)
        );
    }

    // A Yes, seen from the game: the signed-in player's own invitation goes from PENDING to
    // ACCEPTED in this same write, and they take the next seat (isTakingASeat).
    function isAcceptingASeat(gameId, before, after) {
      let phone = myProfile().phone;
      let invitee = inviteePath(gameId, phone);
      return phone in before.invitedPhones
        && get(invitee).data.status == 'PENDING'
        && getAfter(invitee).data.status == 'ACCEPTED'
        && getAfter(invitee).data.playerId == request.auth.uid
        && isTakingASeat(before, after);
    }

    // A Yes: the player is appended to the tee time's slot holders, under their profile name and
    // number, and to playerIds, and nothing else about the game changes. Refused once every slot
    // is taken.
    function isTakingASeat(before, after) {
      return !(request.auth.uid in before.playerIds)
        && isSeating(before, after, mySeat(), [request.auth.uid]);
    }

    // [seat] is appended to the tee time's slot holders and [newPlayerIds] to playerIds, and
    // nothing else about the game changes. Refused once every slot is taken.
    function isSeating(before, after, seat, newPlayerIds) {
      let teeTime = before.teeTimes[0];
      return after.diff(before).affectedKeys().hasOnly(['teeTimes', 'playerIds'])
        && teeTime.players.size() < teeTime.slots
        && after.playerIds == before.playerIds.concat(newPlayerIds)
        && after.teeTimes == [{
          'time': teeTime.time,
          'slots': teeTime.slots,
          'players': teeTime.players.concat([seat])
        }];
    }

    // The organizer's answer for one of their invitees who hasn't answered: only the status
    // changes, from PENDING to ACCEPTED or DECLINED. The invitee's playerId stays the organizer's
    // claim from publish. A Yes comes with that invitee's seat in the same write (the game's own
    // rule checks the seat, isRecordingASeat); a No leaves the game alone.
    function isRecordedAnswer(gameId, phone, before, after) {
      let game = get(gamePath(gameId)).data;
      let gameAfter = getAfter(gamePath(gameId)).data;
      let seats = game.teeTimes[0].players;
      let seatsAfter = gameAfter.teeTimes[0].players;
      return game.organizerId == request.auth.uid
        && phone in game.invitedPhones
        && before.status == 'PENDING'
        && after.diff(before).affectedKeys().hasOnly(['status'])
        && (
          (after.status == 'DECLINED' && gameAfter == game)
          || (after.status == 'ACCEPTED'
            && seatsAfter.size() == seats.size() + 1
            && seatsAfter[seats.size()].phone == phone)
        );
    }

    // A Yes the organizer recorded, seen from the game: the new seat names the invitee by the
    // number they were invited by, and their invitation goes from PENDING to ACCEPTED in this same
    // write. The seat carries the invitee's name as invited and, only when the account the
    // organizer named at publish really owns that number, that account's id, which also joins
    // playerIds. Otherwise the seat has no playerId.
    function isRecordingASeat(gameId, before, after) {
      let teeTime = before.teeTimes[0];
      let phone = after.teeTimes[0].players[teeTime.players.size()].phone;
      let invitee = get(inviteePath(gameId, phone)).data;
      let playerId = invitee.playerId;
      let verified = ownsNumber(playerId, phone) && !(playerId in before.playerIds);
      return before.organizerId == request.auth.uid
        && phone in before.invitedPhones
        && invitee.status == 'PENDING'
        && getAfter(inviteePath(gameId, phone)).data.status == 'ACCEPTED'
        && isSeating(
          before,
          after,
          {'playerId': verified ? playerId : null, 'name': invitee.name, 'phone': phone},
          verified ? [playerId] : []
        );
    }

    // ===============================================================
    // Collections
    // ===============================================================

    match /players/{playerId} {
      // Reading a profile you can already name: your own, or a player shown on an invitation.
      allow get: if isSignedIn();

      // Sign-up's phone-uniqueness check is the only query the app makes against this collection,
      // and it only ever needs one result.
      //
      // Be clear about what this does and does not buy: Firestore rules cannot constrain WHICH
      // field a query filters on, only its shape. Capping the limit blocks a bulk dump and makes
      // scraping slow and expensive, but an authenticated attacker can still page through players
      // one document at a time. Enumeration is mitigated, not eliminated. Closing it properly
      // means a key-addressed uniqueness collection or a callable function.
      allow list: if isSignedIn() && request.query.limit <= 1;

      allow create: if isSelf(playerId)
        && request.resource.data.keys().hasOnly(['name', 'email', 'phone', 'photoUrl'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        // Digits only, enforced server-side: invitation matching compares these values directly,
        // so a formatted number written by a future client bug would silently never match.
        && request.resource.data.phone.matches('^[0-9]{10,15}$')
        && request.resource.data.email == request.auth.token.email;

      allow update: if isSelf(playerId)
        && request.resource.data.keys().hasOnly(['name', 'email', 'phone', 'photoUrl'])
        && request.resource.data.phone.matches('^[0-9]{10,15}$')
        // The email is the auth record's, not the player's to edit here.
        && request.resource.data.email == resource.data.email;

      allow delete: if false;
    }

    match /courses/{courseKey} {
      // Publishing looks a course up by its key. Nothing lists courses yet, so listing stays
      // closed until course suggestions need it.
      allow get: if isSignedIn();
      allow list: if false;

      allow create: if isSignedIn() && isValidCourse(request.resource.data, courseKey);

      // Shared by every organizer and owned by none, so nobody may rename or remove one.
      allow update, delete: if false;
    }

    match /games/{gameId} {
      // The players in a game can see it, and so can anyone invited by the number on their
      // profile. The Games tab queries `playerIds array-contains <uid>` and
      // `invitedPhones array-contains <their phone>`, which this rule can prove for every result,
      // so both queries are allowed and no other game is ever returned.
      allow read: if isSignedIn()
        && (request.auth.uid in resource.data.playerIds || isInvited(resource.data));

      allow create: if isSignedIn() && isValidNewGame(gameId, request.resource.data);

      // The only change allowed so far is a Yes taking a seat: an invitee's own, or one the
      // organizer recorded for them. Organizers can't edit or cancel a game yet.
      allow update: if isSignedIn()
        && (isAcceptingASeat(gameId, resource.data, request.resource.data)
          || isRecordingASeat(gameId, resource.data, request.resource.data));

      allow delete: if false;

      match /invitees/{phone} {
        // Whoever can see the game can see who was invited to it.
        allow read: if isSignedIn()
          && (request.auth.uid in get(gamePath(gameId)).data.playerIds
            || isInvited(get(gamePath(gameId)).data));

        allow create: if isSignedIn() && isPublishingInvitee(gameId, phone);

        // The invitee's own answer, or the organizer's answer for them.
        allow update: if isSignedIn()
          && (isValidAnswer(gameId, phone, resource.data, request.resource.data)
            || isRecordedAnswer(gameId, phone, resource.data, request.resource.data));

        allow delete: if false;
      }
    }

    // Anything not matched above is denied. Previously this block allowed unrestricted read and
    // write, so every collection needs its own rule from here on.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
